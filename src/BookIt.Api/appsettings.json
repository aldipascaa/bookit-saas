{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "Data Source=bookit.db" },
  "Jwt": {
    "Issuer": "BookIt",
    "Audience": "BookIt",
    "ExpiryMinutes": 120
  },
  "RateLimiting": { "AuthPermitLimit": 10, "AuthWindowSeconds": 60 },
  "Cors": { "AllowedOrigins": [] },
  "Seed": { "DemoData": false }
}
